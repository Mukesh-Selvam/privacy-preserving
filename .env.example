# Privacy Gateway — Environment Variables Template
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to source control.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_in_production

# ── HashiCorp Vault ────────────────────────────────────────────────────────────
VAULT_TOKEN=changeme_in_production

# ── Gateway Application ────────────────────────────────────────────────────────
# API key that partner clients must supply in the X-API-Key header
GATEWAY_API_KEY=changeme_in_production

# Spring profile (default | dev | prod)
SPRING_PROFILES_ACTIVE=default
