{
  "manifest_version": 3,
  "name": "Privacy Gateway — Patient Portal",
  "short_name": "Privacy Gateway",
  "version": "1.0.0",
  "description": "Manage your health data consent in real-time. Control which fields insurers and researchers can see. Monitor every data access with a full audit log.",
  "homepage_url": "https://github.com/mukesh/privacy-gateway",
  "author": "Privacy Gateway Team",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Privacy Gateway — Patient Portal"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
